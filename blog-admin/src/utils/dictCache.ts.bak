import { getDictDataByDictTypesApi } from '@/api/system/dict';
import { ref, Ref } from 'vue';

interface DictData {
  list?: DictData[];
  defaultValue?: string;
  dictValue: string;
  dictLabel: string;
  [key: string]: any;
}

interface DictCacheData {
  [dictType: string]: DictData[];

}

class DictCache {
  private cache: DictCacheData = {};
  private loadingPromises: { [dictType: string]: Promise<any> } = {};

  /**
   * 根据字典类型获取字典数据
   * @param dictType 字典类型
   * @returns 字典数据数组
   */
  async getDictData(dictType: string): Promise<DictData[]> {
    // 如果缓存中存在，直接返回
    if (this.cache[dictType]) {
      console.log('从缓存中获取字典数据:', dictType);
      // @ts-ignore
      if(this.cache[dictType].list){
        // @ts-ignore
        return this.cache[dictType].list;
      }
      return this.cache[dictType];
    }

    // 如果正在加载，返回加载中的Promise
    // @ts-ignore
    if (this.loadingPromises[dictType]) {
      return this.loadingPromises[dictType];
    }

    // 开始加载数据
    const loadingPromise = this.fetchDictData(dictType);
    this.loadingPromises[dictType] = loadingPromise;

    try {
      const data = await loadingPromise;
      return data;
    } finally {
      // 清除加载中的Promise
      delete this.loadingPromises[dictType];
    }
  }

  /**
   * 批量获取字典数据
   * @param dictTypes 字典类型数组
   * @returns 字典数据对象，key为字典类型，value为字典数据数组
   */
  async getDictDataBatch(dictTypes: string[]): Promise<DictCacheData> {
    
    const result: DictCacheData = {};
    const needFetchTypes: string[] = [];

    // 先从缓存中获取已有的数据
    for (const dictType of dictTypes) {
      if (this.cache[dictType]) {
        result[dictType] = this.cache[dictType];
      } else {
        needFetchTypes.push(dictType);
      }
    }

    // 如果所有类型都在缓存中，直接返回
    if (needFetchTypes.length === 0) {
      return result;
    }

    // 批量获取需要的数据
    try {
      const data = await this.fetchDictDataBatch(needFetchTypes);
      // 更新缓存并合并结果
      Object.assign(this.cache, data);
      Object.assign(result, data);
    } catch (error) {
      console.error('批量获取字典数据失败:', error);
    }

    return result;
  }

  /**
   * 根据字典类型和字典值获取字典标签
   * @param dictType 字典类型
   * @param dictValue 字典值
   * @param defaultValue 默认值
   * @returns 字典标签或默认值
   */
  async getDictLabel(dictType: string, dictValue: string | number, defaultValue: string = ''): Promise<string> {
    const dictData = await this.getDictData(dictType);
    const item = dictData.find(item => item.dictValue === String(dictValue));
    return item ? item.dictLabel : defaultValue;
  }

  /**
   * 根据字典类型和字典标签获取字典值
   * @param dictType 字典类型
   * @param dictLabel 字典标签
   * @param defaultValue 默认值
   * @returns 字典值或默认值
   */
  async getDictValue(dictType: string, dictLabel: string, defaultValue: string = ''): Promise<string> {
    const dictData = await this.getDictData(dictType);
    const item = dictData.find(item => item.dictLabel === dictLabel);
    return item ? item.dictValue : defaultValue;
  }

  /**
   * 清除指定字典类型的缓存
   * @param dictType 字典类型，不传则清除所有缓存
   */
  clearCache(dictType?: string): void {
    if (dictType) {
      delete this.cache[dictType];
    } else {
      this.cache = {};
    }
  }

  /**
   * 从API获取单个字典类型的数据
   * @param dictType 字典类型
   * @returns 字典数据数组
   */
  private async fetchDictData(dictType: string): Promise<DictData[]> {
    try {
      const response = await getDictDataByDictTypesApi(dictType);
      const data = response.data[dictType].list || [];
      this.cache[dictType] = data;
      return data;
    } catch (error) {
      console.error(`获取字典数据失败 ${dictType}:`, error);
      return [];
    }
  }

  /**
   * 从API批量获取字典类型的数据
   * @param dictTypes 字典类型数组
   * @returns 字典数据对象
   */
  private async fetchDictDataBatch(dictTypes: string[]): Promise<DictCacheData> {
    try {
      const response = await getDictDataByDictTypesApi(dictTypes.join(','));
      const data = response.data || {};
      return data;
    } catch (error) {
      console.error('批量获取字典数据失败:', error);
      return {};
    }
  }
}

// 导出单例实例
const dictCacheInstance = new DictCache();

/**
 * Vue 3 Composition API 字典缓存工具
 * @returns 字典缓存方法
 */
export function useDictCache() {
  const loading: Ref<{ [dictType: string]: boolean }> = ref({});
  const error: Ref<{ [dictType: string]: string | null }> = ref({});

  /**
   * 根据字典类型获取字典数据（带加载状态）
   * @param dictType 字典类型
   * @returns 字典数据数组
   */
  const getDictData = async (dictType: string) => {
    loading.value[dictType] = true;
    error.value[dictType] = null;
    
    try {
      const data = await dictCacheInstance.getDictData(dictType);
      return data;
    } catch (err) {
      const errorMsg = err instanceof Error ? err.message : '获取字典数据失败';
      error.value[dictType] = errorMsg;
      console.error(`获取字典数据失败 ${dictType}:`, err);
      return [];
    } finally {
      loading.value[dictType] = false;
    }
  };

  /**
   * 批量获取字典数据（带加载状态）
   * @param dictTypes 字典类型数组
   * @returns 字典数据对象
   */
  const getDictDataBatch = async (dictTypes: string[]): Promise<DictCacheData> => {
    // 设置所有类型为加载中
    dictTypes.forEach(type => {
      loading.value[type] = true;
      error.value[type] = null;
    });
    
    try {
      const data = await dictCacheInstance.getDictDataBatch(dictTypes);
      return data;
    } catch (err) {
      const errorMsg = err instanceof Error ? err.message : '批量获取字典数据失败';
      dictTypes.forEach(type => {
        error.value[type] = errorMsg;
      });
      console.error('批量获取字典数据失败:', err);
      return {};
    } finally {
      // 清除所有类型的加载状态
      dictTypes.forEach(type => {
        loading.value[type] = false;
      });
    }
  };

  /**
   * 根据字典值获取字典标签
   * @param dictType 字典类型
   * @param dictValue 字典值
   * @param defaultValue 默认值
   * @returns 字典标签
   */
  const getDictLabel = async (dictType: string, dictValue: string | number, defaultValue: string = ''): Promise<string> => {
    return dictCacheInstance.getDictLabel(dictType, dictValue, defaultValue);
  };

  /**
   * 根据字典标签获取字典值
   * @param dictType 字典类型
   * @param dictLabel 字典标签
   * @param defaultValue 默认值
   * @returns 字典值
   */
  const getDictValue = async (dictType: string, dictLabel: string, defaultValue: string = ''): Promise<string> => {
    return dictCacheInstance.getDictValue(dictType, dictLabel, defaultValue);
  };

  /**
   * 清除字典缓存
   * @param dictType 字典类型，不传则清除所有
   */
  const clearCache = (dictType?: string): void => {
    dictCacheInstance.clearCache(dictType);
  };

  return {
    // 状态
    loading,
    error,
    
    // 方法
    getDictData,
    getDictDataBatch,
    getDictLabel,
    getDictValue,
    clearCache
  };
}

// 导出单例实例和composable函数
export default dictCacheInstance;
